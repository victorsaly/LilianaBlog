---
import fs from 'node:fs';
import path from 'node:path';
import type { Story } from '../lib/stories';
import { artUrl } from '../lib/stories';
import { segmentScene } from '../lib/parse.js';

interface Props { story: Story; }
const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const total = story.scenes.length;

// Who speaks a paragraph (for the little speaker portrait)? Reuse the same
// speaker detection the voices use; map the speaker id to its illustration.
const illoDir = path.join(process.cwd(), 'public', 'art', 'illustrations');
function portraitFor(paraText: string): { speaker: string; src: string } | null {
  const seg = (segmentScene(paraText) as any[]).find((s) => s.speaker && s.speaker !== 'narrator' && s.speaker !== 'unknown');
  if (!seg || !fs.existsSync(path.join(illoDir, `${seg.speaker}.png`))) return null;
  return { speaker: seg.speaker, src: `${base}art/illustrations/${seg.speaker}.png` };
}
// the storyteller (Lili) animates with a gentle talk-bob while reading.
// One image (no frame-swap → no flicker).
const storytellerSrc = fs.existsSync(path.join(illoDir, 'lili-face.png')) ? `${base}art/illustrations/lili-face.png` : null;

// Generated sound effects + ambience (npm run sfx) — names without .mp3.
const sfxDir = path.join(process.cwd(), 'public', 'audio', 'sfx');
const sfxFiles = fs.existsSync(sfxDir)
  ? fs.readdirSync(sfxDir).filter((f) => f.endsWith('.mp3')).map((f) => f.replace(/\.mp3$/, ''))
  : [];

// Pre-generated studio audio per scene (npm run voices).
const audioDir = path.join(process.cwd(), 'public', 'audio', story.slug);
function sceneAudio(n: number): { audio: string; timings: string } | null {
  if (fs.existsSync(path.join(audioDir, `scene-${n}.mp3`)) && fs.existsSync(path.join(audioDir, `scene-${n}.json`))) {
    return { audio: `${base}audio/${story.slug}/scene-${n}.mp3`, timings: `${base}audio/${story.slug}/scene-${n}.json` };
  }
  return null;
}

// Establishing picture: a leading image in the story, else an auto-detected
// generated scene picture in public/art/scenes/<slug>/scene-<n>.<ext>.
const sceneArtDir = path.join(process.cwd(), 'public', 'art', 'scenes', story.slug);
function establishing(scene: (typeof story.scenes)[number]): string | null {
  if (scene.image) return artUrl(scene.image, 'scene', base);
  for (const ext of ['png', 'webp', 'jpg', 'jpeg']) {
    if (fs.existsSync(path.join(sceneArtDir, `scene-${scene.n}.${ext}`))) {
      return `${base}art/scenes/${story.slug}/scene-${scene.n}.${ext}`;
    }
  }
  return null;
}

// Build the "stage" (the establishing picture + each inline picture, with the
// word position it appears at) and the text-only paragraphs for each scene.
// Per-paragraph pictures (scene-<n>-p<P>) — one per paragraph, shown while that
// paragraph is read. Each is anchored at the word where its paragraph starts.
function perParagraphStage(scene: (typeof story.scenes)[number]) {
  const stage: { src: string; alt: string; anchor: number }[] = [];
  let words = 0;
  let p = 0;
  for (const b of scene.blocks) {
    if (b.type !== 'text') continue;
    p++;
    let file: string | null = null;
    for (const ext of ['png', 'webp', 'jpg', 'jpeg']) {
      if (fs.existsSync(path.join(sceneArtDir, `scene-${scene.n}-p${p}.${ext}`))) { file = `scene-${scene.n}-p${p}.${ext}`; break; }
    }
    if (file) stage.push({ src: `${base}art/scenes/${story.slug}/${file}`, alt: scene.title, anchor: words });
    words += b.text.trim() ? b.text.trim().split(/\s+/).length : 0;
  }
  return stage;
}

function view(scene: (typeof story.scenes)[number]) {
  const text = scene.blocks.filter((b) => b.type === 'text').map((b) => {
    const t = (b as any).text as string;
    const p = portraitFor(t);
    return { text: t, portrait: p?.src || null, speaker: p?.speaker || null };
  });

  // prefer per-paragraph pictures if they exist
  const pp = perParagraphStage(scene);
  if (pp.length) return { stage: pp, text };

  // otherwise: establishing picture + any inline images
  const lead = establishing(scene);
  const leadIsImage = scene.blocks[0] && scene.blocks[0].type === 'image';
  const stage: { src: string; alt: string; anchor: number }[] = [];
  if (lead) stage.push({ src: lead, alt: scene.alt, anchor: 0 });
  scene.blocks.forEach((b, i) => {
    if (b.type === 'image' && !(leadIsImage && i === 0)) {
      stage.push({ src: artUrl(b.src, 'scene', base)!, alt: b.alt, anchor: b.anchor });
    }
  });
  return { stage, text };
}
---

<div class="reader" id="reader" data-total={total} data-sfx={sfxFiles.join(',')} data-sfxbase={`${base}audio/sfx/`}>
  <div class="reader-top">
    <a class="back-all" href={base}>◀ All stories</a>
    <h1 class="reader-title">{story.emoji} {story.title}</h1>
    <span class="scene-count">Page <b id="scene-now">1</b> of {total}</span>
  </div>

  <div class="scene-progress" aria-hidden="true"><div class="scene-progress-fill" id="scene-progress-fill"></div></div>

  <div class="page">
    {story.scenes.map((scene) => {
      const { stage, text } = view(scene);
      const a = sceneAudio(scene.n);
      return (
        <article class="scene" data-scene={scene.n} data-audio={a?.audio} data-timings={a?.timings} hidden={scene.n !== 1}>
          {stage.length ? (
            <div class="page-art stage" style={`--scene-bg:url('${stage[0].src}')`}>
              {stage.map((im, i) => (
                <img class={`stage-img${i === 0 ? ' on' : ''}`} data-anchor={im.anchor} src={im.src} alt={im.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
              ))}
            </div>
          ) : (
            <div class="page-art placeholder">
              <div>
                <div class="pencil" aria-hidden="true">✏️</div>
                <p><b>Lili's picture goes here!</b></p>
                {scene.draw && <p>{scene.draw}</p>}
              </div>
            </div>
          )}
          <div class="page-body">
            <h2 class="page-scene-title">{scene.title}</h2>
            <div class="page-flow">
              {text.map((t) => (
                t.portrait ? (
                  <div class="say">
                    <img class="speaker-pip" src={t.portrait} alt={t.speaker} loading="lazy" decoding="async" />
                    <p class="page-text">{t.text}</p>
                  </div>
                ) : <p class="page-text">{t.text}</p>
              ))}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <div class="reader-bar">
    <button class="btn btn-ghost nav-arrow" id="prev-btn" type="button">◀ Back</button>
    <button class="btn play-btn" id="play-btn" type="button">▶ Read to me</button>
    <button class="btn btn-ghost" id="restart-btn" type="button" aria-label="Start again">↺<span class="lbl"> Again</span></button>
    <button class="btn btn-ghost speed-btn" id="speed-btn" type="button" aria-label="Reading speed" title="Reading speed">🌟</button>
    <button class="btn btn-teal nav-arrow" id="next-btn" type="button">Next ▶</button>
    <button class="btn btn-ghost" id="sound-btn" type="button" aria-label="Sound on or off" aria-pressed="true">🔊</button>
    {storytellerSrc && <button class="btn btn-ghost" id="fox-btn" type="button" aria-label="Storyteller on or off" aria-pressed="true">🗣️<span class="lbl"> Storyteller</span></button>}
    <input type="checkbox" id="autoplay" hidden />
  </div>

  <p class="hint" id="tap-hint">👆 Tip: tap any <span class="tapword-demo">underlined</span> word to hear it on its own.</p>
  <p class="hint" id="no-speech" hidden>Reading-aloud isn't available in this browser, but you can still read the story and flip the pages. Try Chrome, Edge or Safari for the voice. 💛</p>

  {storytellerSrc && (
    <div class="storyteller" id="fox" hidden aria-hidden="true">
      <div class="teller">
        <img class="storyteller-img" src={storytellerSrc} alt="" loading="lazy" decoding="async" />
        <svg class="mouth" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <g class="mouth-g">
            <ellipse class="m-rim" cx="50" cy="50" rx="39" ry="34" />
            <ellipse class="m-lips" cx="50" cy="52" rx="33" ry="28" />
            <path class="m-teeth" d="M20 33 Q50 25 80 33 L80 45 Q50 39 20 45 Z" />
            <ellipse class="m-tongue" cx="50" cy="78" rx="18" ry="11" />
          </g>
        </svg>
      </div>
    </div>
  )}
</div>

<script>
  import { tokenize, makeChunks } from '../lib/parse.js';

  // Read-along engine. Each page is a "slide": the words stay on screen while a
  // picture on the stage swaps in as the reading passes each point. Studio
  // audio (mp3 + word timings) when available, else free browser voices.
  const root = document.getElementById('reader');
  if (root) {
    const ttsSupport = 'speechSynthesis' in window;
    const synth = ttsSupport ? window.speechSynthesis : null;
    const total = parseInt(root.dataset.total || '1', 10);
    const audio = new Audio();
    audio.preload = 'auto';
    const sfxBase = root.dataset.sfxbase || '';
    const sfxAvail = new Set((root.dataset.sfx || '').split(',').filter(Boolean));
    const ambientAudio = new Audio();
    ambientAudio.loop = true;
    let ambientSource: MediaElementAudioSourceNode | null = null;
    let ambientGain: GainNode | null = null;

    const sceneEls = Array.from(root.querySelectorAll('.scene')) as HTMLElement[];
    const playBtn = document.getElementById('play-btn') as HTMLButtonElement;
    const restartBtn = document.getElementById('restart-btn') as HTMLButtonElement;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const autoplayBox = document.getElementById('autoplay') as HTMLInputElement;
    const speedBtn = document.getElementById('speed-btn') as HTMLButtonElement;
    const sceneNow = document.getElementById('scene-now') as HTMLElement;
    const progressFill = document.getElementById('scene-progress-fill') as HTMLElement | null;

    interface Word { start: number; end: number; el: HTMLElement; }
    interface Stage { anchor: number; el: HTMLElement; }
    interface Para { anchor: number; cue: string | null; }
    interface SceneData {
      el: HTMLElement; words: Word[]; textEls: HTMLElement[]; fullText: string;
      stage: Stage[]; stageCur: number; paras: Para[]; title: string; lastPara: number;
      audioUrl: string; timingsUrl: string; starts: (number | null)[] | null;
    }
    const scenes: SceneData[] = [];

    sceneEls.forEach((el) => {
      const textEls = Array.from(el.querySelectorAll('.page-text')) as HTMLElement[];
      const words: Word[] = [];
      const paras: Para[] = [];
      let fullText = '';
      let cursor = 0;
      textEls.forEach((tEl, bi) => {
        const raw = tEl.textContent || '';
        paras.push({ anchor: words.length, cue: cueForText(raw) });
        if (bi > 0) { fullText += '\n\n'; cursor += 2; }
        const tokens = tokenize(raw);
        tEl.textContent = '';
        for (const t of tokens) {
          if (t.isWord) {
            const span = document.createElement('span');
            span.className = 'w';
            span.textContent = t.text;
            words.push({ start: cursor + t.start, end: cursor + t.end, el: span });
            tEl.appendChild(span);
          } else {
            tEl.appendChild(document.createTextNode(t.text));
          }
        }
        fullText += raw;
        cursor += raw.length;
        tEl.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement).closest('.w') as HTMLElement | null;
          if (!target || playing) return;
          speakWord(target);
        });
      });
      const stage: Stage[] = Array.from(el.querySelectorAll('.stage-img')).map((n) => ({
        anchor: parseInt((n as HTMLElement).dataset.anchor || '0', 10), el: n as HTMLElement,
      }));
      scenes.push({
        el, words, textEls, fullText, stage, stageCur: 0,
        paras, title: el.querySelector('.page-scene-title')?.textContent || '', lastPara: -1,
        audioUrl: el.dataset.audio || '', timingsUrl: el.dataset.timings || '', starts: null,
      });
    });

    const anyAudio = scenes.some((s) => s.audioUrl);
    const canRead = anyAudio || ttsSupport;

    // ---------------------- gentle sound (synthesized, no files) ----------------
    let soundOn = localStorage.getItem('lili-sound') !== 'off';   // default on
    let actx: AudioContext | null = null;
    let master: GainNode | null = null;
    let ambient: { g: GainNode; oscs: OscillatorNode[] } | null = null;
    const soundBtn = document.getElementById('sound-btn') as HTMLButtonElement;

    // Pick a character-specific laugh when we can tell who is laughing (and the
    // matching sound exists), else the general laugh. We only look at a small
    // window AROUND the laugh word ("the potato laughed" → potato), so other
    // names elsewhere in the sentence ("...past Mum's wind...") don't mislead it.
    function laughCueFor(s: string): string {
      const who: [RegExp, string][] = [
        [/\bking\b/, 'laugh-king'],
        [/\bluna\b/, 'laugh-luna'],
        [/\b(cheeto|tito)\b/, 'laugh-cheeto'],
        [/\b(queen|mum|mummy|mother)\b/, 'laugh-mum'],
        [/\blil[iy]\b/, 'laugh-lily'],
        [/\bleo\b/, 'laugh-leo'],
        [/\bpotato\b/, 'laugh-potato'],
      ];
      const m = s.match(/laugh\w*|giggl\w*|chuckl\w*|cackl\w*|chortl\w*|hee-hee|ha-ha|mwahaha/);
      const win = m && m.index != null
        ? s.slice(Math.max(0, m.index - 28), m.index + m[0].length + 18)
        : s;
      for (const [rx, name] of who) if (rx.test(win) && sfxAvail.has(name)) return name;
      return 'laugh';
    }
    function cueForText(t: string): string | null {
      const s = (t || '').toLowerCase();
      if (/laugh|giggl|chuckl|cackle|ha-ha|hee-hee|chortl|mwahaha/.test(s)) return laughCueFor(s);
      if (/restart|reset|game over|poof|fixed/.test(s)) return 'chime';
      if (/saved everyone|teamwork|hooray|cheer|happiest|the end/.test(s)) return 'cheer';
      if (/portal|whoosh|pulled inside|vibrate|buzz|swirl/.test(s)) return 'whoosh';
      if (/zzzt|signal|crack/.test(s)) return 'zzzt';
      if (/breakfast|kitchen|flipping|sizzl/.test(s)) return 'sizzle';
      if (/blaze|parrot|squawk|feather/.test(s)) return 'squawk';
      if (/ketchup|fries|\bfry\b|mash/.test(s)) return 'splat';
      if (/sword|stylus|pickaxe|armour|clang/.test(s)) return 'clang';
      if (/evil|nunchuck|surrender|villain|knocked|great potato/.test(s)) return 'villain';
      if (/power|energy|glow|spark|silver|magic|flame|fire|wind|crackl/.test(s)) return 'sparkle';
      if (/stamp|rumble|march|stone|earth|mash|shook|bumped|thud/.test(s)) return 'thud';
      return null;
    }
    function ensureCtx(): AudioContext | null {
      if (actx) return actx;
      try {
        const AC = (window.AudioContext || (window as any).webkitAudioContext);
        actx = new AC();
        master = actx.createGain(); master.gain.value = soundOn ? 1 : 0; master.connect(actx.destination);
      } catch { actx = null; }
      return actx;
    }
    function resumeCtx() { if (actx && actx.state === 'suspended') actx.resume(); }
    // Route media through Web Audio + GainNode so the level is respected on iOS
    // (iOS/WebKit ignores HTMLAudioElement.volume).
    function ensureAmbientRouting(): boolean {
      const ctx = ensureCtx(); if (!ctx || !master) return false;
      if (!ambientSource) {
        try {
          ambientSource = ctx.createMediaElementSource(ambientAudio);
          ambientGain = ctx.createGain();
          ambientSource.connect(ambientGain); ambientGain.connect(master);
        } catch { return false; }
      }
      return true;
    }
    // Cues play as decoded Web Audio buffers — reliable + level-controlled on iOS,
    // and they can overlap. Buffers are fetched once and cached.
    const cueBuffers: Record<string, AudioBuffer> = {};
    function playFile(name: string, vol: number) {
      const ctx = ensureCtx();
      if (!ctx || !master) { const a = new Audio(sfxBase + name + '.mp3'); a.volume = vol; a.play().catch(() => {}); return; }
      const play = (buf: AudioBuffer) => {
        const s = ctx.createBufferSource(); s.buffer = buf;
        const g = ctx.createGain(); g.gain.value = vol;
        s.connect(g); g.connect(master!); s.start();
      };
      if (cueBuffers[name]) { play(cueBuffers[name]); return; }
      fetch(sfxBase + name + '.mp3').then((r) => r.arrayBuffer()).then((arr) => ctx.decodeAudioData(arr))
        .then((buf) => { cueBuffers[name] = buf; play(buf); }).catch(() => {});
    }
    function moodFor(title: string): number[] {
      const t = (title || '').toLowerCase();
      if (/ocean|cave|deep/.test(t)) return [98.0, 146.83, 196.0];
      if (/portal|inside the game|powers|wonder/.test(t)) return [146.83, 220.0, 293.66];
      if (/deeper|great potato/.test(t)) return [110.0, 164.81, 220.0];
      return [130.81, 164.81, 196.0];
    }
    function moodName(title: string): string {
      const t = (title || '').toLowerCase();
      if (/ocean|cave|deep/.test(t)) return 'ocean';
      if (/portal|inside the game|powers|wonder/.test(t)) return 'magic';
      if (/deeper|great potato/.test(t)) return 'battle';
      return 'warm';
    }
    // background bed: prefer music, then ambience loop, then synth
    function startAmbient(title: string) {
      if (!soundOn) return;
      const mood = moodName(title);
      const bed = sfxAvail.has(`music-${mood}`) ? `music-${mood}` : sfxAvail.has(`amb-${mood}`) ? `amb-${mood}` : null;
      if (bed) {
        stopSynthAmbient();
        const level = bed.startsWith('music') ? 0.1 : 0.14;
        if (ensureAmbientRouting()) { ambientGain!.gain.value = level; ambientAudio.volume = 1; }
        else { ambientAudio.volume = level; }   // desktop fallback if Web Audio unavailable
        ambientAudio.src = sfxBase + bed + '.mp3';
        ambientAudio.play().catch(() => {});
        return;
      }
      startSynthAmbient(title);
    }
    function stopAmbient() { ambientAudio.pause(); stopSynthAmbient(); }
    function startSynthAmbient(title: string) {
      const ctx = ensureCtx(); if (!ctx || !master) return;
      stopSynthAmbient();
      const g = ctx.createGain(); g.gain.value = 0; g.connect(master);
      const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 700; lp.connect(g);
      const oscs = moodFor(title).map((f, i) => { const o = ctx.createOscillator(); o.type = i === 0 ? 'sine' : 'triangle'; o.frequency.value = f; o.detune.value = (i - 1) * 6; o.connect(lp); o.start(); return o; });
      g.gain.linearRampToValueAtTime(0.045, ctx.currentTime + 2);
      ambient = { g, oscs };
    }
    function stopSynthAmbient() {
      if (!ambient || !actx) return;
      const { g, oscs } = ambient; const t = actx.currentTime;
      try { g.gain.cancelScheduledValues(t); g.gain.linearRampToValueAtTime(0, t + 0.5); oscs.forEach((o) => o.stop(t + 0.6)); } catch {}
      ambient = null;
    }
    function tone(freq: number, dur: number, type: OscillatorType, vol: number, delay = 0) {
      const ctx = ensureCtx(); if (!ctx || !master || !soundOn) return;
      const t = ctx.currentTime + delay;
      const o = ctx.createOscillator(); const g = ctx.createGain();
      o.type = type; o.frequency.value = freq; o.connect(g); g.connect(master);
      g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(vol, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0008, t + dur);
      o.start(t); o.stop(t + dur + 0.05);
    }
    function whoosh() {
      const ctx = ensureCtx(); if (!ctx || !master || !soundOn) return;
      const dur = 0.7; const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * dur), ctx.sampleRate);
      const d = buf.getChannelData(0); for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = buf;
      const lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.Q.value = 6;
      const t = ctx.currentTime;
      lp.frequency.setValueAtTime(350, t); lp.frequency.exponentialRampToValueAtTime(1100, t + 0.35); lp.frequency.exponentialRampToValueAtTime(300, t + dur);
      const g = ctx.createGain(); g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(0.05, t + 0.15); g.gain.exponentialRampToValueAtTime(0.0006, t + dur);
      src.connect(lp); lp.connect(g); g.connect(master); src.start(t); src.stop(t + dur);
    }
    // softer "buzz" using a triangle through a lowpass (not harsh square/noise)
    function buzz(freq: number, dur: number, vol: number, delay = 0) {
      const ctx = ensureCtx(); if (!ctx || !master || !soundOn) return;
      const t = ctx.currentTime + delay;
      const o = ctx.createOscillator(); const lp = ctx.createBiquadFilter(); const g = ctx.createGain();
      o.type = 'triangle'; o.frequency.value = freq; lp.type = 'lowpass'; lp.frequency.value = 1400;
      o.connect(lp); lp.connect(g); g.connect(master);
      g.gain.setValueAtTime(0.0001, t); g.gain.linearRampToValueAtTime(vol, t + 0.02); g.gain.exponentialRampToValueAtTime(0.0008, t + dur);
      o.start(t); o.stop(t + dur + 0.05);
    }
    // Per-cue playback volume — the king/villain laughs boom and are more
    // pronounced; the little bunny and mum laughs are softer and gentler.
    const CUE_VOL: Record<string, number> = {
      'laugh-king': 1.0, 'laugh-potato': 0.96, laugh: 0.9,
      'laugh-luna': 0.86, 'laugh-lily': 0.86, 'laugh-leo': 0.86,
      'laugh-mum': 0.78, 'laugh-cheeto': 0.72,
    };
    function playCue(name: string | null) {
      if (!name || !soundOn) return;
      if (sfxAvail.has(name)) { playFile(name, CUE_VOL[name] ?? 0.85); return; }
      if (name === 'sparkle') [1318, 1568, 2093].forEach((f, i) => tone(f, 0.55, 'sine', 0.07, i * 0.08));
      else if (name === 'whoosh') whoosh();
      else if (name === 'zzzt') { buzz(170, 0.13, 0.07); buzz(240, 0.1, 0.06, 0.06); }
      else if (name === 'chime') [523, 659, 784, 1047].forEach((f, i) => tone(f, 0.55, 'sine', 0.08, i * 0.1));
      else if (name === 'thud') tone(82, 0.35, 'sine', 0.13, 0);
      else if (name === 'villain') [196, 165, 131].forEach((f, i) => tone(f, 0.5, 'triangle', 0.06, i * 0.09));
    }
    function setSoundIcon() { if (soundBtn) { soundBtn.innerHTML = (soundOn ? '🔊' : '🔇') + '<span class="lbl"> Sound</span>'; soundBtn.setAttribute('aria-pressed', String(soundOn)); } }
    setSoundIcon();
    soundBtn?.addEventListener('click', () => {
      soundOn = !soundOn; localStorage.setItem('lili-sound', soundOn ? 'on' : 'off'); setSoundIcon();
      if (master) master.gain.value = soundOn ? 1 : 0;
      if (!soundOn) stopAmbient();
      else if (playing) { ensureCtx(); resumeCtx(); startAmbient(scenes[current].title); }
    });

    // ---- storyteller (Lili) — a still face with a code-drawn mouth driven
    // per-word (natural sync, no frame-swap → no flicker). ----
    const fox = document.getElementById('fox');
    const foxBtn = document.getElementById('fox-btn') as HTMLButtonElement | null;
    const mouthG = fox?.querySelector('.mouth-g') as SVGGElement | null;
    let foxOn = localStorage.getItem('lili-fox') !== 'off';
    let mouthCloseT = 0;
    function setMouth(open: number) { if (mouthG) mouthG.style.transform = `scaleY(${open})`; }
    // called on each new spoken word: pop the mouth open a (varied) amount, then ease shut
    function foxSpeakWord() {
      if (!fox || fox.hidden || !mouthG) return;
      const open = 0.42 + Math.random() * 0.42;        // 0.42–0.84, varies so it looks natural
      setMouth(open);
      clearTimeout(mouthCloseT);
      mouthCloseT = window.setTimeout(() => setMouth(0.1), 90 + Math.random() * 70);
    }
    function showFox(on: boolean) {
      if (!fox) return;
      const show = on && foxOn;
      fox.hidden = !show;
      fox.classList.toggle('talking', show);
      if (!show) { clearTimeout(mouthCloseT); setMouth(0.1); }
    }
    function setFoxIcon() { if (foxBtn) { foxBtn.setAttribute('aria-pressed', String(foxOn)); foxBtn.classList.toggle('off', !foxOn); } }
    setFoxIcon();
    foxBtn?.addEventListener('click', () => {
      foxOn = !foxOn; localStorage.setItem('lili-fox', foxOn ? 'on' : 'off'); setFoxIcon();
      showFox(playing);
    });

    // ---- state ----
    let current = 0, playing = false, paused = false;
    let mode: 'audio' | 'tts' = 'tts';
    let lastNow = -1;
    let turnDir: 'next' | 'back' = 'next';   // page-turn direction for the transition
    let rafId: number | null = null;
    let chunks: { text: string; start: number }[] = [];
    let chunkIdx = 0, usedBoundary = false;
    let fallback: number | null = null;

    function settings() {
      try { return Object.assign({ rate: 0.9, voiceURI: '' }, JSON.parse(localStorage.getItem('lili-reading-v1') || '{}')); }
      catch { return { rate: 0.9, voiceURI: '' }; }
    }
    function clampRate(r: number) { return Math.min(1.3, Math.max(0.6, r || 0.9)); }
    function pickVoice(uri: string) {
      if (!synth) return null;
      const voices = synth.getVoices();
      if (uri) { const v = voices.find((v) => v.voiceURI === uri); if (v) return v; }
      const en = voices.filter((v) => /^en/i.test(v.lang));
      return en.find((v) => /natural|samantha|google uk english female|google us english|libby|aria|jenny|sonia/i.test(v.name)) || en[0] || voices[0] || null;
    }

    // ---- stage (the swapping picture) ----
    function updateStage(s: SceneData, idx: number) {
      if (!s.stage.length) return;
      let best = 0;
      if (idx >= 0) for (let i = 0; i < s.stage.length; i++) { if (s.stage[i].anchor <= idx) best = i; else break; }
      if (best === s.stageCur) return;
      s.stage[s.stageCur]?.el.classList.remove('on');
      s.stage[best].el.classList.add('on');
      s.stageCur = best;
    }
    function resetStage(s: SceneData) { s.stage.forEach((im, i) => im.el.classList.toggle('on', i === 0)); s.stageCur = 0; }

    // ---- highlight ----
    function paint(s: SceneData, nowIdx: number) {
      if (nowIdx < 0) return;
      if (nowIdx !== lastNow) {
        const ws = s.words;
        if (nowIdx > lastNow) {
          for (let i = Math.max(lastNow, 0); i < nowIdx; i++) { ws[i].el.classList.add('read'); ws[i].el.classList.remove('now'); }
        } else {
          for (let i = nowIdx + 1; i <= lastNow && i < ws.length; i++) ws[i].el.classList.remove('now', 'read');
          for (let i = 0; i < nowIdx; i++) { ws[i].el.classList.add('read'); ws[i].el.classList.remove('now'); }
        }
        if (ws[nowIdx]) { ws[nowIdx].el.classList.add('now'); ws[nowIdx].el.classList.remove('read'); ensureVisible(ws[nowIdx].el); }
        lastNow = nowIdx;
        foxSpeakWord();   // open Lili's mouth on each new word (natural lip-sync)
      }
      updateStage(s, nowIdx);
      // per-paragraph sound cue when we enter a new paragraph
      if (playing && s.paras.length) {
        let cur = 0;
        for (let i = 0; i < s.paras.length; i++) { if (s.paras[i].anchor <= nowIdx) cur = i; else break; }
        if (cur !== s.lastPara) { s.lastPara = cur; playCue(s.paras[cur].cue); }
      }
    }
    function clearPaint(s: SceneData) { s.words.forEach((w) => w.el.classList.remove('now', 'read')); lastNow = -1; }
    function paintAllRead(s: SceneData) { s.words.forEach((w) => { w.el.classList.add('read'); w.el.classList.remove('now'); }); lastNow = s.words.length - 1; }
    function findWord(words: Word[], idx: number): number {
      let lo = 0, hi = words.length - 1;
      while (lo <= hi) { const mid = (lo + hi) >> 1, w = words[mid]; if (idx < w.start) hi = mid - 1; else if (idx >= w.end) lo = mid + 1; else return mid; }
      return Math.min(lo, words.length - 1);
    }
    function ensureVisible(el: HTMLElement) {
      const scroller = el.closest('.page-body') as HTMLElement | null;
      const useScroller = !!scroller && scroller.scrollHeight > scroller.clientHeight + 4;
      const r = el.getBoundingClientRect();
      let top: number, bottom: number;
      if (useScroller) {
        const s = scroller!.getBoundingClientRect();
        const m = Math.min(70, s.height * 0.3); // smaller margin on a short strip (mobile) so it doesn't over-scroll
        top = s.top + m; bottom = s.bottom - m;
      } else { top = 110; bottom = window.innerHeight - 150; } // leave room for the fixed bottom bar
      if (r.top < top || r.bottom > bottom) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }
    function cancelRaf() { if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; } }
    function stopFallback() { if (fallback !== null) { clearTimeout(fallback); fallback = null; } }
    function dim(s: SceneData, on: boolean) { s.textEls.forEach((t) => t.classList.toggle('is-playing', on)); }

    function setBtn(state: 'play' | 'pause' | 'idle' | 'loading') {
      playBtn.disabled = state === 'loading';
      root!.classList.toggle('is-reading', state === 'play');
      showFox(state === 'play');
      if (state === 'loading') { playBtn.textContent = '⏳ Loading…'; playBtn.classList.remove('is-playing'); }
      else if (state === 'play') { playBtn.textContent = '⏸ Pause'; playBtn.classList.add('is-playing'); }
      else if (state === 'pause') { playBtn.textContent = '▶ Continue'; playBtn.classList.remove('is-playing'); }
      else { playBtn.textContent = '▶ Read to me'; playBtn.classList.remove('is-playing'); }
    }

    // ============================ STUDIO AUDIO ============================
    async function playAudio(s: SceneData) {
      mode = 'audio';
      if (!s.starts) { try { const r = await fetch(s.timingsUrl); const j = await r.json(); s.starts = (j && j.starts) || []; } catch { s.starts = []; } }
      audio.src = s.audioUrl;
      audio.playbackRate = clampRate(settings().rate);
      audio.onended = () => { if (playing) finishScene(); };
      audio.onplaying = () => { if (playing) setBtn('play'); };
      audio.onerror = () => { if (ttsSupport) { setBtn('play'); playTts(s); } else stop(); };
      try { await audio.play(); } catch { /* gesture/autoplay */ }
      runAudioHighlight(s);
    }
    function runAudioHighlight(s: SceneData) {
      cancelRaf();
      let ptr = -1;
      const starts = s.starts || [];
      const tick = () => {
        if (!playing || mode !== 'audio') return;
        const ms = audio.currentTime * 1000;
        let target = ptr, j = ptr + 1;
        while (j < starts.length) { const v = starts[j]; if (v == null) { j++; continue; } if (v <= ms) { target = j; j++; } else break; }
        if (target !== ptr && target >= 0) { ptr = target; paint(s, target); }
        rafId = requestAnimationFrame(tick);
      };
      rafId = requestAnimationFrame(tick);
    }

    // ============================ BROWSER VOICE ==========================
    function playTts(s: SceneData) {
      mode = 'tts';
      if (!synth) { stop(); return; }
      chunks = makeChunks(s.fullText); chunkIdx = 0; usedBoundary = false;
      speakChunk(s);
    }
    function speakChunk(s: SceneData) {
      if (!synth) return;
      if (chunkIdx >= chunks.length) { finishScene(); return; }
      const c = chunks[chunkIdx];
      const u = new SpeechSynthesisUtterance(c.text);
      const cfg = settings();
      u.rate = clampRate(cfg.rate); u.pitch = 1;
      const v = pickVoice(cfg.voiceURI);
      if (v) { u.voice = v; u.lang = v.lang; }
      u.onboundary = (e) => {
        if (e.name && e.name !== 'word' && !(e as any).charLength) return;
        usedBoundary = true; stopFallback();
        paint(s, findWord(s.words, c.start + (e.charIndex || 0)));
      };
      u.onend = () => { if (!playing || mode !== 'tts') return; chunkIdx++; speakChunk(s); };
      u.onerror = () => {};
      synth.speak(u);
      if (!usedBoundary) window.setTimeout(() => { if (playing && mode === 'tts' && !usedBoundary) startTtsFallback(s); }, 380);
    }
    function startTtsFallback(s: SceneData) {
      stopFallback();
      const rate = clampRate(settings().rate);
      let i = lastNow < 0 ? 0 : lastNow;
      const step = () => {
        if (!playing || mode !== 'tts' || usedBoundary || i >= s.words.length) return;
        paint(s, i);
        const w = s.words[i].el.textContent || ''; i++;
        fallback = window.setTimeout(step, Math.max(170, w.length * 55 + 90) / rate);
      };
      step();
    }

    // ============================ CONTROL ================================
    function startScene(idx: number) {
      stop();
      current = idx; showScene(idx);
      const s = scenes[idx];
      clearPaint(s); resetStage(s); s.lastPara = -1;
      if (!canRead) return;
      playing = true; paused = false; dim(s, true);
      if (soundOn) { ensureCtx(); resumeCtx(); startAmbient(s.title); }
      if (s.audioUrl) { setBtn('loading'); playAudio(s); }
      else if (ttsSupport) { setBtn('play'); playTts(s); }
      else { playing = false; setBtn('idle'); }
    }
    function finishScene() {
      stopFallback(); cancelRaf();
      playing = false; paused = false;
      paintAllRead(scenes[current]); dim(scenes[current], false);
      setBtn('idle');
      if (autoplayBox.checked && current < total - 1) window.setTimeout(() => { turnDir = 'next'; startScene(current + 1); }, 550);
    }
    function stop() {
      stopFallback(); cancelRaf(); stopAmbient();
      playing = false; paused = false;
      if (synth) synth.cancel();
      audio.pause();
      if (scenes[current]) dim(scenes[current], false);
      setBtn('idle');
    }
    function pause() { if (!playing) return; if (mode === 'audio') audio.pause(); else if (synth) synth.pause(); stopAmbient(); playing = false; paused = true; setBtn('pause'); dim(scenes[current], false); }
    function resume() {
      if (!paused) return;
      playing = true; paused = false; setBtn('play'); dim(scenes[current], true);
      if (soundOn) { resumeCtx(); startAmbient(scenes[current].title); }
      if (mode === 'audio') { audio.play().catch(() => {}); runAudioHighlight(scenes[current]); }
      else if (synth) synth.resume();
    }

    function speakWord(el: HTMLElement) {
      if (!synth) return;
      synth.cancel();
      const raw = (el.textContent || '').replace(/[^\p{L}\p{N}'’-]/gu, '');
      if (!raw) return;
      const u = new SpeechSynthesisUtterance(raw);
      const cfg = settings();
      u.rate = Math.min(0.9, clampRate(cfg.rate));
      const v = pickVoice(cfg.voiceURI);
      if (v) { u.voice = v; u.lang = v.lang; }
      el.classList.add('now');
      u.onend = u.onerror = () => { window.setTimeout(() => el.classList.remove('now'), 250); };
      synth.speak(u);
    }

    // ---- navigation ----
    function showScene(idx: number) {
      sceneEls.forEach((el, i) => { el.hidden = i !== idx; });
      const cur = sceneEls[idx];
      if (cur) { cur.classList.remove('turn-next', 'turn-back'); void cur.offsetWidth; cur.classList.add(`turn-${turnDir}`); }
      if (sceneNow) sceneNow.textContent = String(idx + 1);
      if (prevBtn) prevBtn.disabled = idx === 0;
      if (nextBtn) nextBtn.disabled = idx === total - 1;
      if (progressFill) progressFill.style.width = `${((idx + 1) / total) * 100}%`;
    }
    function goTo(idx: number) {
      if (idx < 0 || idx >= total) return;
      turnDir = idx >= current ? 'next' : 'back';
      const wasPlaying = playing || paused;
      stop();
      current = idx;
      if (wasPlaying && canRead) startScene(idx);
      else { showScene(idx); clearPaint(scenes[idx]); resetStage(scenes[idx]); }
      root!.scrollIntoView({ block: 'start', behavior: 'smooth' });
    }

    playBtn?.addEventListener('click', () => { if (!canRead) return; if (playing) pause(); else if (paused) resume(); else startScene(current); });
    restartBtn?.addEventListener('click', () => { if (canRead) startScene(current); });
    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    document.addEventListener('keydown', (e) => {
      const tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
      else if (e.key === ' ') { e.preventDefault(); playBtn?.click(); }
    });

    if (autoplayBox) {
      autoplayBox.checked = localStorage.getItem('lili-autoplay') !== 'off';
      autoplayBox.addEventListener('change', () => localStorage.setItem('lili-autoplay', autoplayBox.checked ? 'on' : 'off'));
    }
    // reading speed: a simple icon button cycling Slow → Just right (mum's pick) → Fast
    const SPEEDS = [
      { r: 0.78, icon: '🐢', name: 'Slow', short: 'Slow' },
      { r: 0.92, icon: '🌟', name: "Just right (mum's pick)", short: 'Just right' },
      { r: 1.12, icon: '🐇', name: 'Fast', short: 'Fast' },
    ];
    function nearestSpeed(r: number) { let bi = 1, bd = 9; SPEEDS.forEach((s, i) => { const d = Math.abs(s.r - (r || 0.92)); if (d < bd) { bd = d; bi = i; } }); return bi; }
    let speedIdx = nearestSpeed(settings().rate);
    function applySpeed(save: boolean) {
      const s = SPEEDS[speedIdx];
      if (speedBtn) { speedBtn.innerHTML = s.icon + '<span class="lbl"> ' + s.short + '</span>'; speedBtn.title = `Reading speed: ${s.name}`; }
      if (save) { const cur = settings(); cur.rate = s.r; localStorage.setItem('lili-reading-v1', JSON.stringify(cur)); }
      if (mode === 'audio') audio.playbackRate = clampRate(s.r);
    }
    applySpeed(false);
    speedBtn?.addEventListener('click', () => { speedIdx = (speedIdx + 1) % SPEEDS.length; applySpeed(true); });

    if (!canRead) {
      document.getElementById('no-speech')?.removeAttribute('hidden');
      document.getElementById('tap-hint')?.setAttribute('hidden', '');
      if (playBtn) playBtn.disabled = true;
      if (restartBtn) restartBtn.disabled = true;
      speedBtn?.setAttribute('hidden', '');
    }
    if (!ttsSupport) document.getElementById('tap-hint')?.setAttribute('hidden', '');
    if (synth) synth.onvoiceschanged = () => {};

    showScene(0);
    window.addEventListener('pagehide', () => { if (synth) synth.cancel(); audio.pause(); ambientAudio.pause(); });
  }
</script>
