---
// A shared dialog for all the "make reading comfy" controls.
// Opened by the ⚙️ Reading button in the header.
---

<dialog class="settings" id="settings-dialog" aria-label="Reading settings">
  <div class="settings-head">
    <h2>⚙️ Reading comfort</h2>
    <button class="btn btn-icon" id="settings-close" aria-label="Close settings">✕</button>
  </div>

  <div class="settings-body">
    <div class="field">
      <label>Letter style</label>
      <div class="choices" id="font-choices" role="group" aria-label="Font">
        <button class="chip" data-font="lexend">Lexend</button>
        <button class="chip" data-font="dyslexic" style="font-family:'OpenDyslexic',sans-serif">OpenDyslexic</button>
        <button class="chip" data-font="andika">Andika</button>
        <button class="chip" data-font="plain">Plain</button>
      </div>
    </div>

    <div class="field">
      <label>Page colour</label>
      <div class="swatches" id="bg-choices" role="group" aria-label="Background colour">
        <button data-bg="cream" style="background:#fffdf6" aria-label="Cream"></button>
        <button data-bg="white" style="background:#ffffff" aria-label="White"></button>
        <button data-bg="blue" style="background:#eaf2ff" aria-label="Soft blue"></button>
        <button data-bg="peach" style="background:#fdeee4" aria-label="Peach"></button>
        <button data-bg="mint" style="background:#e9f7ee" aria-label="Mint"></button>
        <button data-bg="night" style="background:#2a2740" aria-label="Night"></button>
      </div>
    </div>

    <div class="field">
      <label for="size-range">Text size</label>
      <input type="range" id="size-range" min="1.0" max="2.6" step="0.1" />
    </div>

    <div class="field">
      <label for="line-range">Line spacing</label>
      <input type="range" id="line-range" min="1.4" max="2.6" step="0.1" />
    </div>

    <div class="field">
      <label for="word-range">Space between words</label>
      <input type="range" id="word-range" min="0" max="0.5" step="0.02" />
    </div>

    <div class="field">
      <label>Calm focus (dim the other words while reading)</label>
      <div class="choices" id="calm-choices" role="group" aria-label="Calm focus">
        <button class="chip" data-calm="off">Off</button>
        <button class="chip" data-calm="on">On</button>
      </div>
    </div>

    <div class="field" id="voice-field">
      <label for="voice-select">Narrator voice</label>
      <select id="voice-select"></select>
    </div>

    <div class="field" id="rate-field">
      <label for="rate-range">Reading speed 🐢 → 🐇</label>
      <input type="range" id="rate-range" min="0.6" max="1.3" step="0.05" />
    </div>

    <button class="btn btn-ghost" id="settings-reset">↺ Reset to comfy defaults</button>
  </div>
</dialog>

<script>
  const KEY = 'lili-reading-v1';
  const DEF = { font: 'lexend', bg: 'cream', size: 1.5, line: 1.9, word: 0.16, calm: 'off', voiceURI: '', rate: 0.9 };

  function load() {
    try { return Object.assign({}, DEF, JSON.parse(localStorage.getItem(KEY) || '{}')); }
    catch { return { ...DEF }; }
  }
  function save(s: typeof DEF) { localStorage.setItem(KEY, JSON.stringify(s)); }

  function apply(s: typeof DEF) {
    const el = document.documentElement;
    el.dataset.font = s.font;
    el.dataset.bg = s.bg;
    el.dataset.calm = s.calm;
    el.style.setProperty('--read-size', s.size + 'rem');
    el.style.setProperty('--read-line', String(s.line));
    el.style.setProperty('--read-word', s.word + 'em');
  }

  let state = load();
  apply(state);

  const dialog = document.getElementById('settings-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-settings');
  const closeBtn = document.getElementById('settings-close');

  openBtn?.addEventListener('click', () => { syncUI(); dialog?.showModal(); });
  closeBtn?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  function update(patch: Partial<typeof DEF>) {
    state = Object.assign({}, state, patch);
    apply(state);
    save(state);
    document.dispatchEvent(new CustomEvent('lili:reading-change', { detail: state }));
    syncUI();
  }

  // ---- wire up the controls ----
  function pressGroup(containerId: string, attr: string, value: string) {
    document.querySelectorAll<HTMLButtonElement>(`#${containerId} [data-${attr}]`).forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset[attr] === value));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('#font-choices [data-font]').forEach((b) =>
    b.addEventListener('click', () => update({ font: b.dataset.font })));
  document.querySelectorAll<HTMLButtonElement>('#bg-choices [data-bg]').forEach((b) =>
    b.addEventListener('click', () => update({ bg: b.dataset.bg })));
  document.querySelectorAll<HTMLButtonElement>('#calm-choices [data-calm]').forEach((b) =>
    b.addEventListener('click', () => update({ calm: b.dataset.calm })));

  const sizeR = document.getElementById('size-range') as HTMLInputElement;
  const lineR = document.getElementById('line-range') as HTMLInputElement;
  const wordR = document.getElementById('word-range') as HTMLInputElement;
  const rateR = document.getElementById('rate-range') as HTMLInputElement;
  const voiceS = document.getElementById('voice-select') as HTMLSelectElement;

  sizeR?.addEventListener('input', () => update({ size: parseFloat(sizeR.value) }));
  lineR?.addEventListener('input', () => update({ line: parseFloat(lineR.value) }));
  wordR?.addEventListener('input', () => update({ word: parseFloat(wordR.value) }));
  rateR?.addEventListener('input', () => update({ rate: parseFloat(rateR.value) }));
  voiceS?.addEventListener('change', () => update({ voiceURI: voiceS.value }));

  document.getElementById('settings-reset')?.addEventListener('click', () => {
    state = { ...DEF };
    apply(state); save(state);
    document.dispatchEvent(new CustomEvent('lili:reading-change', { detail: state }));
    syncUI();
  });

  function populateVoices() {
    if (!('speechSynthesis' in window) || !voiceS) return;
    const voices = speechSynthesis.getVoices().filter((v) => /^en/i.test(v.lang));
    voiceS.innerHTML = '';
    const auto = document.createElement('option');
    auto.value = ''; auto.textContent = 'Automatic (best English voice)';
    voiceS.appendChild(auto);
    voices.forEach((v) => {
      const o = document.createElement('option');
      o.value = v.voiceURI; o.textContent = `${v.name} (${v.lang})`;
      voiceS.appendChild(o);
    });
    voiceS.value = state.voiceURI || '';
  }

  if ('speechSynthesis' in window) {
    populateVoices();
    speechSynthesis.onvoiceschanged = populateVoices;
  } else {
    document.getElementById('voice-field')?.setAttribute('hidden', '');
    document.getElementById('rate-field')?.setAttribute('hidden', '');
  }

  function syncUI() {
    pressGroup('font-choices', 'font', state.font);
    pressGroup('bg-choices', 'bg', state.bg);
    pressGroup('calm-choices', 'calm', state.calm);
    if (sizeR) sizeR.value = String(state.size);
    if (lineR) lineR.value = String(state.line);
    if (wordR) wordR.value = String(state.word);
    if (rateR) rateR.value = String(state.rate);
    if (voiceS) voiceS.value = state.voiceURI || '';
  }
  syncUI();
</script>
