---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'characters' | 'story';
  ogImage?: string;
}
const { title, description = "Lili's Story World — read-along illustrated stories.", active, ogImage } = Astro.props;
const base = import.meta.env.BASE_URL; // ends with "/"
const origin = Astro.site ? Astro.site.origin : '';
// absolute URL for the share-preview image (a colourful scene by default)
const shareImg = `${origin}${base}art/scenes/the-great-potato-adventure/scene-1.jpg`;
const ogImageUrl = ogImage ? `${origin}${base}${ogImage}` : shareImg;
const canonical = `${origin}${base}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#12b3a6" />

    <!-- Installable app (PWA) -->
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/icon-180.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Lili's Stories" />

    <!-- Social share previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Lili's Story World" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Reading fonts: a reading-optimised font, a literacy font, and a
         highly-legible font. OpenDyslexic is loaded locally in global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Lexend:wght@400;500;700&family=Andika:wght@400;700&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Apply the saved reading settings BEFORE the page paints (no flicker). -->
    <script is:inline>
      (function () {
        var DEF = { font: 'lexend', bg: 'cream', size: 1.5, line: 1.9, word: 0.16, calm: 'off' };
        var s = DEF;
        try { s = Object.assign({}, DEF, JSON.parse(localStorage.getItem('lili-reading-v1') || '{}')); } catch (e) {}
        var el = document.documentElement;
        el.dataset.font = s.font;
        el.dataset.bg = s.bg;
        el.dataset.calm = s.calm;
        el.style.setProperty('--read-size', s.size + 'rem');
        el.style.setProperty('--read-line', String(s.line));
        el.style.setProperty('--read-word', s.word + 'em');
      })();
    </script>

    <!-- register the service worker (offline + installable) + wire the refresh button -->
    <script>
      window.addEventListener('load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.register(import.meta.env.BASE_URL + 'sw.js').catch(() => {});
        }
        document.getElementById('app-refresh')?.addEventListener('click', async () => {
          document.getElementById('app-refresh')?.classList.add('spinning');
          try {
            if ('serviceWorker' in navigator) {
              const rs = await navigator.serviceWorker.getRegistrations();
              await Promise.all(rs.map((r) => r.update()));
            }
          } catch (e) {}
          location.reload();
        });
      });
    </script>
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main">Skip to the story</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <span class="logo" aria-hidden="true">📖</span>
          <span>Lili's Story World</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href={base} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${base}characters/`} aria-current={active === 'characters' ? 'page' : undefined}>Characters</a>
          <button id="app-refresh" class="app-refresh" type="button" title="Refresh the app" aria-label="Refresh the app">↻</button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>Made with 💛 for Liliana and her family. Stories you can listen to and read along.</p>
    </footer>
  </body>
</html>
