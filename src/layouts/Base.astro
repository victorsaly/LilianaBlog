---
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: 'home' | 'characters' | 'story';
  ogImage?: string;
  jsonLd?: object | object[];   // extra schema.org structured data for this page
  preloadImage?: string;        // base-relative path of the LCP image to preload
}
const { title, description = "Lili's Story World — read-along illustrated stories.", active, ogImage, jsonLd, preloadImage } = Astro.props;
const base = import.meta.env.BASE_URL; // ends with "/"
const origin = Astro.site ? Astro.site.origin : '';
// absolute URL for the share-preview image (the branded 1200×630 card by default,
// or a per-page image such as a story's opening scene)
const shareImg = `${origin}${base}share-card.png`;
const ogImageUrl = ogImage ? `${origin}${base}${ogImage}` : shareImg;
// this page's own absolute URL (so each page self-canonicalizes correctly)
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

// schema.org: the site itself, plus anything this page adds (e.g. a story Book)
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "Lili's Story World",
  url: `${origin}${base}`,
  description: 'Illustrated read-along storybooks — every page reads itself aloud with the words lighting up.',
};
const ldBlocks = [siteLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {preloadImage && <link rel="preload" as="image" href={`${base}${preloadImage}`} />}
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta name="theme-color" content="#12b3a6" />

    <!-- Installable app (PWA) -->
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}icons/icon-180.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Lili's Stories" />

    <!-- Social share previews -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    {!ogImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:site_name" content="Lili's Story World" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Structured data (schema.org) for richer search + share results -->
    {ldBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Fonts actually used everywhere: Baloo 2 (display), Fraunces (headings),
         Lexend (the default reading font). Loaded non-render-blocking so first
         paint is fast. Andika (an optional reading font) is fetched on demand
         below, and OpenDyslexic is a local @font-face in global.css. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Lexend:wght@400;500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Lexend:wght@400;500;700&display=swap"
      />
    </noscript>
    <!-- Andika is only needed when the reader picks it — fetch it then (and on
         first load if it's the saved choice), not for everyone. -->
    <script is:inline>
      (function () {
        var ANDIKA = 'https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap';
        function ensure() {
          if (document.documentElement.dataset.font === 'andika' && !document.getElementById('font-andika')) {
            var l = document.createElement('link');
            l.id = 'font-andika'; l.rel = 'stylesheet'; l.href = ANDIKA;
            document.head.appendChild(l);
          }
        }
        ensure();
        new MutationObserver(ensure).observe(document.documentElement, { attributes: true, attributeFilter: ['data-font'] });
      })();
    </script>

    <!-- Apply the saved reading settings BEFORE the page paints (no flicker). -->
    <script is:inline>
      (function () {
        var DEF = { font: 'lexend', bg: 'cream', size: 1.5, line: 1.9, word: 0.16, calm: 'off' };
        var s = DEF;
        try { s = Object.assign({}, DEF, JSON.parse(localStorage.getItem('lili-reading-v1') || '{}')); } catch (e) {}
        var el = document.documentElement;
        el.dataset.font = s.font;
        el.dataset.bg = s.bg;
        el.dataset.calm = s.calm;
        el.style.setProperty('--read-size', s.size + 'rem');
        el.style.setProperty('--read-line', String(s.line));
        el.style.setProperty('--read-word', s.word + 'em');
      })();
    </script>

    <!-- register the service worker (offline + installable) + wire the refresh button -->
    <script>
      window.addEventListener('load', () => {
        if (import.meta.env.PROD) {
          // Production: register the service worker for offline support.
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register(import.meta.env.BASE_URL + 'sw.js').catch(() => {});
          }
        } else if ('serviceWorker' in navigator) {
          // Development: a previously-installed service worker caches CSS/JS
          // cache-first and would serve STALE assets — hiding your edits. Remove
          // it, clear its caches, and reload once so you always see the latest.
          navigator.serviceWorker.getRegistrations().then((rs) => {
            if (!rs.length) return;
            Promise.all(rs.map((r) => r.unregister()))
              .then(() => (window.caches ? caches.keys().then((ks) => Promise.all(ks.map((k) => caches.delete(k)))) : null))
              .then(() => location.reload());
          });
        }
        document.getElementById('app-refresh')?.addEventListener('click', async () => {
          document.getElementById('app-refresh')?.classList.add('spinning');
          try {
            if ('serviceWorker' in navigator) {
              const rs = await navigator.serviceWorker.getRegistrations();
              await Promise.all(rs.map((r) => r.update()));
            }
          } catch (e) {}
          location.reload();
        });

        // Share this page — native share sheet on mobile, copy-link on desktop.
        const shareBtn = document.getElementById('app-share');
        shareBtn?.addEventListener('click', async () => {
          const url = location.href;
          if (navigator.share) { try { await navigator.share({ title: document.title, url }); } catch (e) {} return; }
          try {
            await navigator.clipboard.writeText(url);
            // The icons both live in the markup; flipping data-state swaps which
            // one shows, so confirming a copy never rewrites the button's label.
            shareBtn.dataset.state = 'b';
            shareBtn.setAttribute('aria-label', 'Link copied');
            window.setTimeout(() => {
              delete shareBtn.dataset.state;
              shareBtn.setAttribute('aria-label', 'Share this page');
            }, 1400);
          } catch (e) {}
        });

        // Full screen toggle — hides the browser's UI for an app-like feel.
        // Shown only when NOT already running standalone and the API exists.
        const fsBtn = document.getElementById('app-fullscreen');
        const docEl = document.documentElement;
        const reqFs = docEl.requestFullscreen || docEl.webkitRequestFullscreen || docEl.mozRequestFullScreen;
        const exitFs = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen;
        const standalone = matchMedia('(display-mode: standalone)').matches || matchMedia('(display-mode: fullscreen)').matches || navigator.standalone === true;
        if (fsBtn && reqFs && !standalone) {
          fsBtn.hidden = false;
          const inFs = () => document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement;
          const sync = () => {
            const on = !!inFs();
            if (on) fsBtn.dataset.state = 'b'; else delete fsBtn.dataset.state;
            fsBtn.title = on ? 'Exit full screen' : 'Full screen';
            fsBtn.setAttribute('aria-label', fsBtn.title);
          };
          fsBtn.addEventListener('click', () => {
            try { if (inFs()) exitFs.call(document); else reqFs.call(docEl); } catch (e) {}
          });
          document.addEventListener('fullscreenchange', sync);
          document.addEventListener('webkitfullscreenchange', sync);
          sync();
        }
      });
    </script>
  </head>
  <body data-page={active}>
    <a class="skip-link" href="#main">Skip to the story</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <svg class="logo" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.5C10.5 5.2 8.6 4.5 6 4.5H3v13h3c2.6 0 4.5.7 6 2 1.5-1.3 3.4-2 6-2h3v-13h-3c-2.6 0-4.5.7-6 2Z" />
            <path d="M12 6.5v14" />
          </svg>
          <span>Lili's Story World</span>
        </a>
        <nav class="nav" aria-label="Main">
          <a href={base} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href={`${base}characters/`} aria-current={active === 'characters' ? 'page' : undefined}>Characters</a>
          <button id="app-fullscreen" class="app-refresh" type="button" title="Full screen" aria-label="Full screen" hidden>
            <svg class="i-a" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
            <svg class="i-b" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
          </button>
          <button id="app-share" class="app-refresh" type="button" title="Share this page" aria-label="Share this page">
            <svg class="i-a" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13.5a3.5 3.5 0 0 0 5.1.4l3-3a3.5 3.5 0 0 0-5-5l-1.7 1.7" /><path d="M14 10.5a3.5 3.5 0 0 0-5.1-.4l-3 3a3.5 3.5 0 0 0 5 5l1.7-1.7" /></svg>
            <svg class="i-b" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7" /></svg>
          </button>
          <button id="app-refresh" class="app-refresh" type="button" title="Refresh the app" aria-label="Refresh the app">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9" /><path d="M20 4v4.5h-4.5" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <p>Made with love for Liliana and her family — stories you can listen to and read along. 💛</p>
    </footer>
  </body>
</html>
