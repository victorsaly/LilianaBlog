---
import Base from '../../layouts/Base.astro';
import Reader from '../../components/Reader.astro';
import { getStories, getStory } from '../../lib/stories';

export function getStaticPaths() {
  return getStories().map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${story.title} · Lili's Story World`} active="story" description={story.tagline}>
  <section style="margin-top:0.6rem">
    <Reader story={story} />
  </section>
</Base>
