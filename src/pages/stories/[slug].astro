---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import Reader from '../../components/Reader.astro';
import { getStories, getStory } from '../../lib/stories';

export function getStaticPaths() {
  return getStories().map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;

// Per-story social-share preview: use this story's opening scene so a shared
// link shows THIS book (not the default site card).
const scenesDir = path.join(process.cwd(), 'public', 'art', 'scenes', story.slug);
const sceneExt = ['jpg', 'jpeg', 'png', 'webp'].find((e) => fs.existsSync(path.join(scenesDir, `scene-1.${e}`)));
const ogImage = sceneExt ? `art/scenes/${story.slug}/scene-1.${sceneExt}` : undefined;

// schema.org Book for this story (richer search/share cards)
const origin = Astro.site ? Astro.site.origin : '';
const bookLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: story.title,
  author: { '@type': 'Person', name: story.author || 'Lili' },
  url: `${origin}${base}stories/${story.slug}/`,
  image: ogImage ? `${origin}${base}${ogImage}` : `${origin}${base}share-card.png`,
  description: story.tagline,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: "Lili's Story World", url: `${origin}${base}` },
};
---

<Base title={`${story.title} · Lili's Story World`} active="story" description={story.tagline} ogImage={ogImage} jsonLd={bookLd} preloadImage={ogImage}>
  <section style="margin-top:0.6rem">
    <Reader story={story} />
  </section>
</Base>
